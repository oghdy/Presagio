# /opt/presagio/.env on the collector VM (P-044, D-058). scripts/vm/setup.sh writes it once from
# this template (mode 600) and never overwrites it; only TAILSCALE_IP is kept current.
# @POSTGRES_PASSWORD@ is a fresh `openssl rand -hex 24`, used both by the container (docker
# compose reads this file) and by DATABASE_URL, so the two can never differ (D-059 2: a wrong
# password looks like a database that is down). Never commit or print this file.

# docker compose: the same docker-compose.yml as the Mac plus the VM override (Tailscale bind).
COMPOSE_PROJECT_NAME=presagio
COMPOSE_FILE=docker-compose.yml:scripts/vm/compose.vm.yml
POSTGRES_USER=presagio
POSTGRES_PASSWORD=@POSTGRES_PASSWORD@
POSTGRES_DB=presagio
POSTGRES_HOST_PORT=5433
# The VM's Tailscale IPv4 address (`tailscale ip -4`); compose.vm.yml binds 5433 to it.
TAILSCALE_IP=@TAILSCALE_IP@

# presagio.config. The VM itself talks to the database over loopback.
DATABASE_URL=postgresql+psycopg://presagio:@POSTGRES_PASSWORD@@127.0.0.1:5433/presagio
DB_CONNECT_TIMEOUT=3

# The Odds API (D-026). Empty = the odds step is skipped. A human fills this line after the
# merge (README section 8, collector VM); it is never typed into a chat or a file in the repo.
ODDS_API_KEY=

# Closing captures (D-027, D-038): the default. The systemd timer (presagio-odds.timer) fires at
# these ET times plus the wrapper's WEEKEND_CLOSING_ET on Saturdays and Sundays; if this line
# changes, change the timer too (tests/scripts/test_vm_scripts.py pins the two together).
ODDS_CLOSING_TIMES_ET=18:45,19:45,21:45
