# Copy to .env and edit if needed:  cp .env.example .env
# Every value here is a local-development placeholder, not a real secret. Never commit .env.

# Used by docker-compose.yml to create the local database container.
POSTGRES_USER=presagio
POSTGRES_PASSWORD=presagio
POSTGRES_DB=presagio
# Host port for the container. 5433 avoids clashing with a native PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# Used by the Python code (presagio.config). Must match the four values above.
DATABASE_URL=postgresql+psycopg://presagio:presagio@localhost:5433/presagio
# Seconds to wait for a TCP connection before giving up.
DB_CONNECT_TIMEOUT=3
