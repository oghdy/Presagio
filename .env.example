# Copy to .env and edit if needed:  cp .env.example .env
# Every value here is a local-development placeholder, not a real secret. Never commit .env.

# Used by docker-compose.yml to create the local database container.
POSTGRES_USER=presagio
POSTGRES_PASSWORD=presagio
POSTGRES_DB=presagio
# Host port for the container. 5433 avoids clashing with a native PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# Used by the Python code (presagio.config). Must match the four values above.
# 127.0.0.1, not localhost: localhost also resolves to ::1, where the container is not bound.
DATABASE_URL=postgresql+psycopg://presagio:presagio@127.0.0.1:5433/presagio
# Seconds to wait for a TCP connection before giving up.
DB_CONNECT_TIMEOUT=3

# External request policy (presagio.ingestion, D-024). The values below are the defaults.
# Seconds between the end of one response and the next request (minimum 0.6).
HTTP_MIN_INTERVAL=1.0
# Seconds before one request times out.
HTTP_TIMEOUT=10.0
# Retries for timeouts, connection errors and 5xx only. 403/429 and other 4xx never retry.
HTTP_MAX_RETRIES=3
# Backoff before retry n: HTTP_BACKOFF_BASE * 2**(n-1) seconds (1, 2, 4) + up to JITTER seconds.
HTTP_BACKOFF_BASE=1.0
HTTP_BACKOFF_JITTER=0.5
# A run still 'running' after this many hours (crashed process) is closed as 'aborted'.
STALE_RUN_HOURS=6.0

# The Odds API (D-026). Put the real key only in your own .env; leave it empty here.
# Empty means the odds adapter is disabled (nothing is called).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# One /odds request costs (number of markets) x (number of regions) credits: 3 with these.
ODDS_API_REGIONS=us
ODDS_API_MARKETS=h2h,spreads,totals

# Daily ingest times (D-027; scheduling itself is stage 6). The full `presagio ingest-daily`
# run, Korean time: 16:00 KST = 03:00 ET (summer) / 02:00 ET (winter), after every game of the
# previous US Eastern date has ended.
INGEST_DAILY_TIME_KST=16:00
# `presagio ingest-daily --odds-only` closing-odds captures, US Eastern time, at most 3.
ODDS_CLOSING_TIMES_ET=18:45,19:45,21:45
# ingest-daily reloads the team list when no teams load succeeded in this many hours (a week).
TEAMS_REFRESH_HOURS=168
